!--------------------------------------------------------------
! Example FCC-ee MAD-X script
! This script prepares the ttbar (E=182.5 GeV) lattice for ensuing tracking studies.
! The thick sequences is loaded.
! Depending on the setting, the lattice will be tapered and a thin version for tracking will be exported.
!--------------------------------------------------------------

SET, FORMAT="19.15f";
option,update_from_parent=true; // new option in mad-x as of 2/2019

!--------------------------------------------------------------
! General settings
!--------------------------------------------------------------

RadiationAndRF = 1; // 1 to enable RF, radiation, and tapering; 0 to disable them

!--------------------------------------------------------------
! Lattice selection and beam parameters
!--------------------------------------------------------------

CALL, FILE="fcc_ee_data/fccee_t.seq";

pbeam :=   182.5;
EXbeam = 1.46e-9;
EYbeam = 2.9e-12;
Nbun :=    1;
NPar :=   1;
HalfCrossingAngle = 0.015;

Ebeam := sqrt( pbeam^2 + emass^2 );

// Beam defined without radiation as a start - radiation is turned on later depending on the requirements
BEAM, PARTICLE=POSITRON, NPART=Npar, KBUNCH=Nbun, ENERGY=Ebeam, RADIATE=FALSE, BV=+1, EX=EXbeam, EY=EYbeam;

!--------------------------------------------------------------
! Load aperture definitions and perform sequence edits
!--------------------------------------------------------------

// Load the aperture definition
!CALL, FILE="FCCee_aper_definitions.madx";
!CALL, FILE="install_synchrotron_rad_masks.madx";


!-------------------------------------------------------------------------------
! Perform initial TWISS and survey in an ideal machine without radiation
!-------------------------------------------------------------------------------


! BPMs that we still won't be using
! BPMSW.1L2.B1: MONITOR;
! BPMSW.1R2.B1: MONITOR;

! seqedit, sequence=FCCEE_P_RING;
!   flatten;
!   install, element=BPMSW.1L2.B1, at=0.351, from=QC1L1.1;
!   install, element=BPMSW.1R2.B1, at=4.75045, from=QC1L1.1;
!   endedit;

!USE, SEQUENCE = FCCEE_P_RING;
USE, PERIOD = FCCEE_P_RING;

// Save the voltage settings for the cavities for later use if needed
VOLTCA1SAVE = VOLTCA1; 
VOLTCA2SAVE = VOLTCA2; 

SHOW, VOLTCA1SAVE, VOLTCA2SAVE;

// Turn off the cavities for ideal machine twiss and survey
VOLTCA1 = 0;
VOLTCA2 = 0;


// Place where the initial conditions are saved - used for RF matching later if needed
SAVEBETA, LABEL=B.IP, PLACE=#s, SEQUENCE=FCCEE_P_RING;

!SURVEY, file="survey_madx_t_b1.tfs", THETA0 = HalfCrossingAngle;
TWISS, FILE = "twiss_t_b1_nottapered.tfs", TOLERANCE=1E-12; ! Twiss without radiation and tapering
TWISS, FILE = "twiss_t_b1_nottapered_c.tfs", TOLERANCE=1E-12 , centre=True; ! Twiss without radiation and tapering centered
!APERTURE, HALO={6,6,6,6}, COR=250e-6, DP=0, BBEAT=1.1, DPARX=0, DPARY=0, DQF=0.25, BETAQFX=93, FILE="aperture_t_b1_nottapered.tfs"; //on-momentum parameters

errq1l1 =  0.001 ;
errq1r1 = -0.0018 ; 
!errq1l1 =  0.00 ;
!errq1r1 = 0.00 ; 



QC1L1.1, K1 := K1QC1L1 + errq1l1 ; 
QC1R1.2, K1 := K1QC1R1 + errq1r1 ; 

TWISS, FILE = "twiss_t_b1_nottapered_err.tfs", TOLERANCE=1E-12; ! Twiss without radiation and tapering



zx = 0.000025;
zpx = 0;
zy = 0.000001;
zpy = 0;





PTC_CREATE_UNIVERSE;
PTC_CREATE_LAYOUT,model=2,method=6, nst=10;
PTC_START,x =zx, px =zpx, y = zy, py = zpy ;
call, file="quad.obs_ptc.madx";
PTC_TRACK,icase=4, CLOSED_ORBIT=false ,dump,
element_by_element,
turns=100,file="track_fcc", ffile=1, norm_no=1,
onetable;
PTC_TRACK_END;
PTC_END;



