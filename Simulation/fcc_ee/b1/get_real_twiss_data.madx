!--------------------------------------------------------------
! Example FCC-ee MAD-X script
! This script prepares the ttbar (E=182.5 GeV) lattice for ensuing tracking studies.
! The thick sequences is loaded.
! Depending on the setting, the lattice will be tapered and a thin version for tracking will be exported.
!--------------------------------------------------------------

SET, FORMAT="19.15f";
option,update_from_parent=true; // new option in mad-x as of 2/2019

!--------------------------------------------------------------
! General settings
!--------------------------------------------------------------

RadiationAndRF = 1; // 1 to enable RF, radiation, and tapering; 0 to disable them

!--------------------------------------------------------------
! Lattice selection and beam parameters
!--------------------------------------------------------------

CALL, FILE = "fccee_t.seq";

pbeam :=   182.5;
EXbeam = 1.46e-9;
EYbeam = 2.9e-12;
Nbun :=    1;
NPar :=   1;
HalfCrossingAngle = 0.015;

Ebeam := sqrt( pbeam^2 + emass^2 );

// Beam defined without radiation as a start - radiation is turned on later depending on the requirements
BEAM, PARTICLE=POSITRON, NPART=Npar, KBUNCH=Nbun, ENERGY=Ebeam, RADIATE=FALSE, BV=+1, EX=EXbeam, EY=EYbeam;


!USE, SEQUENCE = FCCEE_P_RING;
USE, PERIOD = FCCEE_P_RING;

// Save the voltage settings for the cavities for later use if needed
VOLTCA1SAVE = VOLTCA1; 
VOLTCA2SAVE = VOLTCA2; 

SHOW, VOLTCA1SAVE, VOLTCA2SAVE;

// Turn off the cavities for ideal machine twiss and survey
VOLTCA1 = 0;
VOLTCA2 = 0;


// Place where the initial conditions are saved - used for RF matching later if needed
SAVEBETA, LABEL=B.IP, PLACE=#s, SEQUENCE=FCCEE_P_RING;

! Twiss.optics contains the infor of all the elements
select, flag=twiss, clear;
select, flag=twiss,column=name,s,betx,mux,bety,muy,x,y,alfx,alfy, keyword;
TWISS, FILE = "twiss.optics", TOLERANCE=1E-12; ! Twiss without radiation and tapering
TWISS, FILE = "twiss_c.optics", TOLERANCE=1E-12 , centre=True; ! Twiss without radiation and tapering centered


! Twiss.dat contain only info of the quadrupoles and IPs

select, flag=twiss, clear;
select, flag=twiss,pattern="^Q.*",column=name,s,betx,mux,bety,muy,x,y,alfx,alfy, keyword;
select, flag=twiss,pattern="^IP.*",column=name,s,betx,mux,bety,muy,x,y,alfx,alfy, keyword;

TWISS, FILE = "twiss.dat", TOLERANCE=1E-12; ! Twiss without radiation and tapering
TWISS, FILE = "twiss_c.dat", TOLERANCE=1E-12 , centre=True; ! Twiss without radiation and tapering centered



ASSIGN, ECHO="Quad_KyL.txt", TRUNCATE;

PRINTF, TEXT="QC2R1 length strength: %f, %f",VALUE= QC1R1->L, QC1R1->K1 ;
PRINTF, TEXT="QC1R2 length strength: %f, %f",VALUE= QC1R2->L, QC1R2->K1 ;
