PRINT, TEXT="Starting errors twiss and tracking";

CALL, FILE = "IR_errors.madx"
PRINT, TEXT="Read errors";

TWISS, FILE = "twiss_err.tfs", TOLERANCE=1E-12; ! Twiss without radiation and tapering


! INITIAL CONDITIONS
zx = 0.000025;
zpx = 0;
zy = 0.000001;
zpy = 0;


! THIS ONE IS TO CHECK BEHAVIOUR WITH DIFFERENT delta0
! zx = 0.00002345;
! zpx = 0;
! zy = 0.000000782;
! zpy = 0;


PTC_CREATE_UNIVERSE;
PTC_CREATE_LAYOUT,model=2,method=6, nst=10;
PTC_START,x =zx, px =zpx, y = zy, py = zpy ;
call,file="quad.obs_ptc.madx";
PTC_TRACK,icase=4, CLOSED_ORBIT=false ,dump,
element_by_element,
turns=100,file = "track_fcc", ffile=1, norm_no=1,
onetable;
PTC_TRACK_END;
PTC_END;



